; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="cafefekr"
config/version="2.1.6"
run/main_scene="res://scenes/main/main.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/bg_color=Color(0.12, 0.08, 0.05, 1)
boot_splash/image="res://assets/images/splash.png"
config/icon="res://assets/icons/logo.png"
run/max_fps.mobile=60

[audio]

buses/default_bus_layout="uid://bro4er6r3un0c"
general/playback_latency=30
general/playback_latency.mobile=75

[autoload]

GameManager="*res://autoload/game_manager.gd"
ResponsiveUI="*res://autoload/responsive_ui.gd"
NetworkManager="*res://autoload/network_manager.gd"
AudioManager="*res://autoload/audio_manager.gd"
ActionVFXManager="*res://autoload/action_vfx_manager.gd"

[debug]

gdscript/warnings/enable=false
gdscript/warnings/unused_variable=0
gdscript/warnings/unused_private_class_variable=0
gdscript/warnings/unused_parameter=0
gdscript/warnings/unused_signal=0
gdscript/warnings/shadowed_variable=0
gdscript/warnings/shadowed_variable_base_class=0
gdscript/warnings/shadowed_global_identifier=0
gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/resizable=false
window/size/window_width_override=500
window/size/window_height_override=950
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[gui]

theme/custom="res://resources/cafe_theme.tres"
theme/custom_font="res://assets/fonts/Vazir.ttf"

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

3d/physics_engine="GodotPhysics3D"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
renderer/rendering_method.web="compatibility"
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.mobile=512
textures/default_filters/use_nearest_mipmap_filter=true
lights_and_shadows/positional_shadow/atlas_size.mobile=0
anti_aliasing/quality/msaa_2d.mobile=0
anti_aliasing/quality/msaa_3d.mobile=0
anti_aliasing/quality/screen_space_aa.mobile=0
anti_aliasing/quality/use_debanding.mobile=false
scaling_3d/mode.mobile=1
scaling_3d/scale.mobile=0.7
