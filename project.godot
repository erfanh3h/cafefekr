; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="cafefekr"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.3", "Mobile")
config/icon="res://assets/icons/logo.png"
boot_splash/show_image=false
boot_splash/minimum_display_time=0

[audio]

general/playback_latency=30
general/playback_latency.mobile=50

[autoload]

GameManager="*res://autoload/game_manager.gd"
NetworkManager="*res://autoload/network_manager.gd"
AudioManager="*res://autoload/audio_manager.gd"
ActionVFXManager="*res://autoload/action_vfx_manager.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/vsync/vsync_mode=1

[gui]

theme/custom_font="res://assets/fonts/Vazir.ttf"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
renderer/rendering_method.web="compatibility"
scaling_3d/mode=0
scaling_3d/scale.mobile=0.85
scaling_3d/scale=1.0
rendering_device/driver.windows="d3d12"
textures/vram_compression/import_etc2_astc=true
